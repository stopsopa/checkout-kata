{
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/serve-index": "^1.9.4",
    "c8": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "check": "NODE_OPTIONS= npx tsc -p tsconfig.json",
    "tests": "/bin/bash ts.sh --test",
    "style:check": "NODE_OPTIONS='' npx prettier --config prettier.config.cjs --check .",
    "style:fix": "NODE_OPTIONS='' npx prettier --config prettier.config.cjs --write .",
    "style:list": "NODE_OPTIONS='' npx prettier --config prettier.config.cjs --list-different .",
    "coverage:server": "/bin/bash bash/coverage.sh",
    "server": "node --env-file .env --watch server.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:fixtures": "/bin/bash ts.sh database/fixtures.ts",
    "docker:up": "/bin/bash docker/docker-compose.sh up",
    "docker:down": "/bin/bash docker/docker-compose.sh down"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "serve-index": "^1.9.2",
    "zod": "^4.4.3"
  }
}
