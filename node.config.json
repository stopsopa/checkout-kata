{
  "$schema": "https://nodejs.org/dist/v24.13.0/docs/node-config-schema.json",
  "nodeOptions": {
    "warnings": false
  },
  "testRunner": {
    "experimental-test-coverage": true,
    "test-coverage-lines": 80,
    "test-coverage-include": ["src/**/*", "database/**/*"],
    "test-coverage-exclude": [
      "bootstrap/**/*",
      "**/*.test.*",
      "src/interfaces/iCheckout.ts",
      "database/fixtures.ts",
      "database/context.ts"
    ]
  }
}
